def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--panel-a-tsv", required=True)
    parser.add_argument("--strict-table", required=True)
    parser.add_argument("--panel-e-svg-source", required=True)
    parser.add_argument("--out", required=True)
    args = parser.parse_args()

    out = Path(args.out).resolve()
    out.mkdir(parents=True, exist_ok=True)
    fonts = configure_fonts()
    panel_a = load_panel_a(Path(args.panel_a_tsv).resolve())
    strict, counts = load_strict(Path(args.strict_table).resolve())

    panel_paths: dict[str, dict[str, str]] = {}
